<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.crazy-airhead</groupId>
        <artifactId>aifei-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>aifei</artifactId>
    <packaging>jar</packaging>

    <name>aifei</name>
    <description>Aifei core module</description>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                aifei-all 模块无法使用 maven-source-plugin 与 maven-javadoc-plugin 打包，
                需要各子模块而非 parent 模块中独立配置这两个插件使用。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <!-- 构建时把 java-templates 下的模板过滤后生成 cn.aifei.core.Version 版本常量类。
                 输出直接写到 src/main/java 覆盖随仓库提交的默认文件：
                 保证未构建前 IDE 不报红，升级 revision 后随 pom 一起提交更新 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <configuration>
                    <outputDirectory>${basedir}/src/main/java</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-version-class</id>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
